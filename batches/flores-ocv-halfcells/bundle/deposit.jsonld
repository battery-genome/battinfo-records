              "@type": "ConstantCurrentDischarging",
              "rdfs:label": "Constant current at C/50 to the lower voltage cutoff",
              "hasControlParameter": [
                {
                  "@type": "CRate",
                  "hasNumericalPart": {
                    "hasNumberValue": 0.02
                  },
                  "hasMeasurementUnit": {
                    "@id": "electrochemistry:AmperePerAmpereHour"
                  }
                }
              ]
            },
            {
              "@type": "VoltageHold",
              "rdfs:label": "Potentiostatic hold for 6 h at the lower voltage cutoff",
              "hasTerminationParameter": [
                {
                  "@type": "Duration",
                  "hasNumericalPart": {
                    "hasNumberValue": 6.0
                  },
                  "hasMeasurementUnit": {
                    "@id": "emmo:Hour"
                  }
                }
              ]
            },
            {
              "@type": "ConstantCurrentCharging",
              "rdfs:label": "Constant current at C/50 to the upper voltage cutoff",
              "hasControlParameter": [
                {
                  "@type": "CRate",
                  "hasNumericalPart": {
                    "hasNumberValue": 0.02
                  },
                  "hasMeasurementUnit": {
                    "@id": "electrochemistry:AmperePerAmpereHour"
                  }
                }
              ]
            },
            {
              "@type": "VoltageHold",
              "rdfs:label": "Potentiostatic hold for 6 h at the upper voltage cutoff",
              "hasTerminationParameter": [
                {
                  "@type": "Duration",
                  "hasNumericalPart": {
                    "hasNumberValue": 6.0
                  },
                  "hasMeasurementUnit": {
                    "@id": "emmo:Hour"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "@type": [
        "prov:Plan",
        "schema:HowTo",
        "GalvanostaticIntermittentTitrationTechnique"
      ],
      "@id": "https://w3id.org/battinfo/spec/rd8x-1nqr-3dp2-0we8",
      "schema:name": "GITT",
      "schema:additionalType": "gitt",
      "schema:description": "Sequence of current pulses (C/50) followed by a period of rest (150 minutes). A rest period of 6 h is applied upon reaching the upper and lower voltage cutoffs. 5 cycles, room temperature.",
      "hasTask": [
        {
          "@type": "IterativeWorkflow",
          "NumberOfIterations": {
            "hasNumericalPart": {
              "hasNumberValue": 5
            }
          },
          "hasTask": [
            {
              "@type": "IterativeWorkflow",
              "hasTask": [
                {
                  "@type": "ConstantCurrentDischarging",
                  "rdfs:label": "Current pulse at C/50",
                  "hasControlParameter": [
                    {
                      "@type": "CRate",
                      "hasNumericalPart": {
                        "hasNumberValue": 0.02
                      },
                      "hasMeasurementUnit": {
                        "@id": "electrochemistry:AmperePerAmpereHour"
                      }
                    }
                  ]
                },
                {
                  "@type": "OpenCircuitHold",
                  "rdfs:label": "Rest for 150 minutes",
                  "hasTerminationParameter": [
                    {
                      "@type": "Duration",
                      "hasNumericalPart": {
                        "hasNumberValue": 150.0
                      },
                      "hasMeasurementUnit": {
                        "@id": "emmo:Minute"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "@type": "OpenCircuitHold",
              "rdfs:label": "Rest for 6 h at the lower voltage cutoff",
              "hasTerminationParameter": [
                {
                  "@type": "Duration",
                  "hasNumericalPart": {
                    "hasNumberValue": 6.0
                  },
                  "hasMeasurementUnit": {
                    "@id": "emmo:Hour"
                  }
                }
              ]
            },
            {
              "@type": "IterativeWorkflow",
              "hasTask": [
                {
                  "@type": "ConstantCurrentCharging",
                  "rdfs:label": "Current pulse at C/50",
                  "hasControlParameter": [
                    {
                      "@type": "CRate",
                      "hasNumericalPart": {
                        "hasNumberValue": 0.02
                      },
                      "hasMeasurementUnit": {
                        "@id": "electrochemistry:AmperePerAmpereHour"
                      }
                    }
                  ]
                },
                {
                  "@type": "OpenCircuitHold",
                  "rdfs:label": "Rest for 150 minutes",
                  "hasTerminationParameter": [
                    {
                      "@type": "Duration",
                      "hasNumericalPart": {
                        "hasNumberValue": 150.0
                      },
                      "hasMeasurementUnit": {
                        "@id": "emmo:Minute"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "@type": "OpenCircuitHold",
              "rdfs:label": "Rest for 6 h at the upper voltage cutoff",
              "hasTerminationParameter": [
                {
                  "@type": "Duration",
                  "hasNumericalPart": {
                    "hasNumberValue": 6.0
                  },
                  "hasMeasurementUnit": {
                    "@id": "emmo:Hour"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
