    },
    {
      "@type": [
        "prov:Plan",
        "schema:HowTo",
        "PseudoOpenCircuitVoltageMethod"
      ],
      "@id": "https://w3id.org/battinfo/spec/1pvg-sjjy-kn8j-jhxh",
      "schema:name": "p-OCV",
      "schema:additionalType": "quasi_ocv",
      "schema:description": "Constant current cycling at C/50. A rest period of 8 h is applied upon reaching the upper and lower voltage cutoffs. 5 cycles, room temperature.",
      "hasTask": [
        {
          "@type": "IterativeWorkflow",
          "NumberOfIterations": {
            "hasNumericalPart": {
              "hasNumberValue": 5
            }
          },
          "hasTask": [
            {
              "@type": "ConstantCurrentDischarging",
              "rdfs:label": "Constant current at C/50 to the lower voltage cutoff",
              "hasControlParameter": [
                {
                  "@type": "CRate",
                  "hasNumericalPart": {
                    "hasNumberValue": 0.02
                  },
                  "hasMeasurementUnit": {
                    "@id": "electrochemistry:AmperePerAmpereHour"
                  }
                }
              ]
            },
            {
              "@type": "OpenCircuitHold",
              "rdfs:label": "Rest for 8 h at the lower voltage cutoff",
              "hasTerminationParameter": [
                {
                  "@type": "Duration",
                  "hasNumericalPart": {
                    "hasNumberValue": 8.0
                  },
                  "hasMeasurementUnit": {
                    "@id": "emmo:Hour"
                  }
                }
              ]
            },
            {
              "@type": "ConstantCurrentCharging",
              "rdfs:label": "Constant current at C/50 to the upper voltage cutoff",
              "hasControlParameter": [
                {
                  "@type": "CRate",
                  "hasNumericalPart": {
                    "hasNumberValue": 0.02
                  },
                  "hasMeasurementUnit": {
                    "@id": "electrochemistry:AmperePerAmpereHour"
                  }
                }
              ]
            },
            {
              "@type": "OpenCircuitHold",
              "rdfs:label": "Rest for 8 h at the upper voltage cutoff",
              "hasTerminationParameter": [
                {
                  "@type": "Duration",
                  "hasNumericalPart": {
                    "hasNumberValue": 8.0
                  },
                  "hasMeasurementUnit": {
                    "@id": "emmo:Hour"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "@type": [
        "prov:Plan",
        "schema:HowTo",
        "PseudoOpenCircuitVoltageMethod"
      ],
      "@id": "https://w3id.org/battinfo/spec/ne02-d84m-66a5-xq69",
      "schema:name": "p-OCV hold",
      "schema:additionalType": "quasi_ocv",
      "schema:description": "Constant current cycling at C/50. The voltage is held for 6 h under potentiostatic control upon reaching the upper and lower voltage cutoffs. 5 cycles, room temperature.",
      "hasTask": [
        {
          "@type": "IterativeWorkflow",
          "NumberOfIterations": {
            "hasNumericalPart": {
              "hasNumberValue": 5
            }
          },
          "hasTask": [
