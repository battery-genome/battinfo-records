            },
            {
              "mode": "rest",
              "duration": {
                "value": 150.0,
                "unit": "min"
              },
              "description": "Rest for 150 minutes"
            }
          ]
        },
        {
          "mode": "cv",
          "duration": {
            "value": 6.0,
            "unit": "h"
          },
          "description": "Potentiostatic hold for 6 h at the upper voltage cutoff"
        }
