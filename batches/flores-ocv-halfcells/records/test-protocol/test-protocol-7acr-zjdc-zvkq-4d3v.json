      "description": "5 cycles",
      "count": 5,
      "steps": [
        {
          "mode": "group",
          "description": "Current pulses at C/50 with 150-min rests toward the lower voltage cutoff",
          "steps": [
            {
              "mode": "cc",
              "setpoints": {
                "c_rate": {
                  "value": 0.02,
                  "unit": "1/h"
                }
              },
              "description": "Current pulse at C/50"
            },
            {
              "mode": "rest",
              "duration": {
                "value": 150.0,
                "unit": "min"
              },
              "description": "Rest for 150 minutes"
            }
          ]
        },
        {
          "mode": "cv",
          "duration": {
            "value": 6.0,
            "unit": "h"
          },
          "description": "Potentiostatic hold for 6 h at the lower voltage cutoff"
        },
        {
          "mode": "group",
